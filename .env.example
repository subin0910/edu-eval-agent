# Keep real credentials in .env locally and Streamlit secrets in deployment.
OPENAI_API_KEY=your_key_here
ROUTER_MODEL=gpt-4.1
GENERATOR_MODEL=gpt-5.4
# Evaluation target: single-question answers must finish within 20 seconds.
SINGLE_GENERATION_TIMEOUT=17
# Multi-question generation is a slower OPTIONAL feature, not the 20s evaluation path.
BATCH_GENERATION_TIMEOUT=110
